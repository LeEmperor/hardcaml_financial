(library
 (name cme_parser_test_support)
 (wrapped false)
 (modules cme_feed_parser_testbench)
 (libraries core hardcaml cme_of_hardcaml cme_schema schema_test_support hardcaml_step_testbench hardcaml_verif cme_verif stream_test_support)
 (preprocess (pps ppx_hardcaml ppx_jane)))

(library
 (name cme_feed_parser_inline_tests)
 (modules cme_feed_parser_unit_quickcheck_tests cme_feed_parser_expect_tests cme_feed_parser_contract_tests phase6_stress_tests)
 ; ppx_expect v0.18 preview needs the copied source directory as its root.
 (inline_tests
  (deps ../../../docs/templates.xml)
  (flags (:standard -source-tree-root .)))
 (libraries cme_parser_test_support core hardcaml cme_of_hardcaml cme_schema schema_test_support hardcaml_step_testbench hardcaml_verif cme_verif stream_test_support)
 (preprocess (pps ppx_hardcaml ppx_jane)))

(executable
 (name phase6_performance)
 (modules phase6_performance)
 (libraries core cme_parser_test_support)
 (preprocess (pps ppx_jane)))

(rule
 (alias performance-check)
 (deps ../../../docs/templates.xml)
 (action (run %{exe:phase6_performance.exe} --check)))

(rule
 (alias performance-report)
 (deps ../../../docs/templates.xml)
 (action (run %{exe:phase6_performance.exe})))

